#!/usr/bin/env python3
"""Aggiunge un pacco alla scheda Pacchi dell'app (per Daneel, quando trova un codice di spedizione nelle mail).

  pacco "CODICE" ["nome breve"]      es. pacco 1UW1WEZAMFKLA "Felpa venduta su Vinted"

Se il pacco c'è già non succede niente (al più cambia il nome). Stampa corriere e fase in JSON.
"""

import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

a = sys.argv[1:]
if not 1 <= len(a) <= 2:
    sys.exit(__doc__)
token = (Path.home() / ".config/daneel-app/token").read_text().strip()
dati = {"codice": a[0], "nome": a[1] if len(a) > 1 else ""}
req = urllib.request.Request("http://127.0.0.1:8791/api/pacchi/aggiungi", json.dumps(dati).encode(),
                             {"Content-Type": "application/json", "Authorization": "Bearer " + token})
try:
    p = json.load(urllib.request.urlopen(req, timeout=120))
    print(json.dumps({k: p.get(k) for k in ("codice", "nome", "corriere", "fase", "errore")}, ensure_ascii=False))
except urllib.error.HTTPError as e:
    sys.exit(f"Pacco non aggiunto: {json.load(e).get('detail', e)}")
except (urllib.error.URLError, OSError) as e:
    sys.exit(f"L'app non risponde: {e}")
